# PostgreSQL. Cambia la contraseña antes del primer arranque.
POSTGRES_DB=gusti
POSTGRES_USER=gusti
POSTGRES_PASSWORD=replace_me_local

# Producción. Usa el origen HTTPS público sin ruta ni barra final.
APP_ORIGIN=
# Solo con un proxy que sobrescribe X-Real-IP y es el único ingreso.
ORDER_TRUST_PROXY=false

# Persistencia. Deja en blanco para usar los nombres derivados del proyecto.
# Para adoptar volúmenes existentes, indica ambos nombres y habilita esta opción.
GUSTI_EXTERNAL_VOLUMES=false
POSTGRES_VOLUME_NAME=
MENU_MEDIA_VOLUME_NAME=

# Solo desarrollo local. DATABASE_URL es para Node ejecutado fuera de Docker.
APP_PORT=3000
POSTGRES_PORT=5432
DATABASE_URL=postgresql://gusti:replace_me_local@localhost:5432/gusti?schema=public
# COOKIE_SECURE=false # Predeterminado solo en el override local.

# Multimedia
MEDIA_MAX_MB=15
MEDIA_VIDEO_MAX_SECONDS=30

# Google Sheets (opcional)
GOOGLE_SHEETS_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_KEY=

# Canva (opcional)
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=
CANVA_REDIRECT_URI=
INTEGRATION_ENCRYPTION_KEY=
