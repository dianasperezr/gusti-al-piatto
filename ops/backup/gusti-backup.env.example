# Copiar a /etc/gusti-backup.env con permisos 0600.
GUSTI_PROJECT_DIR=/srv/gusti
GUSTI_ENV_FILE=/srv/gusti/.env
GUSTI_COMPOSE_PROJECT=gusti
GUSTI_BACKUP_HOST=gusti-produccion
# GUSTI_RELEASE=revision-desplegada
RESTIC_REPOSITORY=s3:https://s3.example.invalid/gusti-backups/produccion
RESTIC_PASSWORD_FILE=/etc/gusti-backup.password
# Las credenciales del proveedor también van en un archivo de acceso restringido.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
